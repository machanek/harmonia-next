* text=auto eol=lf

# Windows batch trzymaj w CRLF
*.bat eol=crlf
*.cmd eol=crlf

# Binary (bez normalizacji)
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.ico binary
*.pdf binary

# Tekstowe trzymamy w LF
*.svg  text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf
